---
/**
 * Funil de vendas da Hotmart (one-click upsell/downsell).
 * O Hotmart Checkout Elements monta os botões de aceitar/recusar em #hotmart-sales-funnel.
 * Fica dentro de .esconder → só aparece no pitch da VSL.
 */
---

<div id="hotmart-sales-funnel"></div>

<script is:inline>
  (function () {
    function mount() {
      try { checkoutElements.init('salesFunnel').mount('#hotmart-sales-funnel'); } catch (e) {}
    }
    var s = document.createElement('script');
    s.src = 'https://checkout.hotmart.com/lib/hotmart-checkout-elements.js';
    s.async = true;
    s.onload = mount;
    document.head.appendChild(s);
  })();
</script>
