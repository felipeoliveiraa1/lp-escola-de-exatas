---
/** Card de preço (torre). Props opcionais p/ variar plano/badge/desc/cta (ex.: 2 planos concursos). */
export interface Props {
  checkout: string;
  price?: string;
  installment?: string;
  plan?: string;
  badge?: string; // '' = sem badge
  desc?: string; // HTML permitido (set:html)
  ctaLabel?: string;
  isBest?: boolean; // borda amarela de destaque
}
const {
  checkout,
  price = 'R$ 297',
  installment = '12x de R$ 30',
  plan = '01 ano de acesso',
  badge = 'Melhor opção',
  desc = 'Você viu tudo o que está incluso até aqui, um pacote avaliado em mais de <s>R$ 3.670</s>. Hoje, tudo isso pode ser seu, com <b>1 ano de acesso</b>, por apenas:',
  ctaLabel = 'QUERO 01 ANO DE ACESSO',
  isBest = true,
} = Astro.props;
---

<div class:list={['price-card', { 'is-best': isBest }]}>
  <img class="price-card__logo" src="/assets/logo-exatas.webp" alt="A Escola de Exatas" width="168" height="134" loading="lazy" />
  <div class="price-card__plan">{plan}</div>
  {badge && <span class="price-card__badge">{badge}</span>}
  <p class="price-card__desc" set:html={desc}></p>
  <div class="price-card__price">{price}</div>
  <div class="price-card__inst">à vista ou até <b>{installment}</b></div>
  <a class="btn btn--pulse" href={checkout} rel="nofollow">{ctaLabel}</a>
  <img class="price-card__secure" src="/assets/compra-segura.svg" alt="Compra 100% segura" width="280" height="50" loading="lazy" />
</div>
