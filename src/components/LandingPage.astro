  <!-- Delay/gate da VSL (teste A/B): revela .esconder no pitch da variante sorteada -->
  <script is:inline define:vars={{ pitchMap, pitchFallback }}>
    (function () {
      // QA: ?preview revela tudo na hora (sem esperar o pitch)
      try {
        if (/[?&]preview/.test(location.search)) {
          var els = document.querySelectorAll('.esconder');
          for (var i = 0; i < els.length; i++) els[i].classList.remove('esconder');
          return;
        }
      } catch (e) {}
      var alreadyInitialized = false;
      document.addEventListener('player:ready', function (event) {
        if (alreadyInitialized) return;
        var detail = event.detail || {};
        var config = detail.config || {};
        var player = detail.player || document.querySelector('vturb-smartplayer');
        var playerId = config.id;
        var delay = (pitchMap && pitchMap[playerId] != null) ? pitchMap[playerId] : pitchFallback;
        if (delay == null || !player || typeof player.displayHiddenElements !== 'function') return;
        alreadyInitialized = true;
        player.displayHiddenElements(delay, ['.esconder'], { persist: true });
      });
    })();
  </script>
