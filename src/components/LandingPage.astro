        <a class="btn btn--pulse" href="#valor">QUERO DOMINAR EXATAS AGORA</a>
      </div>
    </div>
    <script is:inline>
      (function () {
        var bg = document.querySelector('.garantia [data-parallax]');
        if (!bg) return;
        var sec = bg.closest('.garantia');
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        var ticking = false;
        function update() {
          ticking = false;
          var r = sec.getBoundingClientRect();
          var vh = window.innerHeight || document.documentElement.clientHeight;
          if (r.bottom < -120 || r.top > vh + 120) return;
          var prog = (r.top + r.height / 2 - vh / 2) / vh; // ~ -1..1
          bg.style.transform = 'translate3d(0,' + (prog * 200).toFixed(1) + 'px,0)';
        }
        function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </section>

  <!-- 15. Atenção + countdown -->
  <section class="section bg-black">
