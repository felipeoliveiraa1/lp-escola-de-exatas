---
/**
 * Página de funil (upsell/downsell) — one-click Hotmart.
 * Cabeçalho + VSL nativa + funil da Hotmart que aparece no pitch (.esconder).
 */
import Funnel from '../layouts/Funnel.astro';
import VslNative from './VslNative.astro';
import HotmartFunnel from './HotmartFunnel.astro';

export interface Props {
  title: string;
  heading: string;
  sub: string;
  playerId: string; // id PURO, sem `vid-`
  delaySeconds: number;
  /** URL do stream .m3u8 p/ preload (otimização de velocidade da VSL). Opcional. */
  m3u8?: string;
  /** ID do Google Ads (gtag) — só nas páginas -google */
  gtagId?: string;
}
const { title, heading, sub, playerId, delaySeconds, m3u8, gtagId } = Astro.props;
const ACCOUNT = '1f136267-6fae-424a-a2af-6f55173425e6';
const playerJs = `https://scripts.converteai.net/${ACCOUNT}/players/${playerId}/v4/player.js`;
const smartplayerJs = 'https://scripts.converteai.net/lib/js/smartplayer-wc/v4/smartplayer.js';
---

<Funnel title={title} poster={null} gtagId={gtagId}>
  {m3u8 && (
    <Fragment slot="head">
      <script is:inline>!function(i,n){i._plt=i._plt||(n&&n.timeOrigin?n.timeOrigin+n.now():Date.now())}(window,performance);</script>
      <link rel="preload" href={playerJs} as="script" />
      <link rel="preload" href={smartplayerJs} as="script" />
      <link rel="preload" href={m3u8} as="fetch" />
    </Fragment>
  )}
  <main class="upsell">
    <div class="container center upsell__inner">
      <h1 class="upsell__title">{heading}</h1>
      <p class="upsell__sub">{sub}</p>
      <VslNative account={ACCOUNT} playerId={playerId} delaySeconds={delaySeconds} />
      <!-- aparece no pitch: funil one-click da Hotmart (aceitar/recusar) -->
      <div class="esconder upsell__offer">
        <HotmartFunnel />
      </div>
    </div>
  </main>
</Funnel>

<style is:global>
  body { background: #fff; }
</style>
