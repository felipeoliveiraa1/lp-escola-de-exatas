<Funnel title="A Escola de Exatas — Domine as Exatas nos Concursos" poster="/assets/hero-concursos.webp">
  <div class="lp-concursos">
  <!-- 1. HERO estático branco (sem VSL, sem botão — fiel ao original) -->
