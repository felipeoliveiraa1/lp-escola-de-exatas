  <!-- lazy real p/ imagens avulsas below-fold (não disputar banda com o hero/LCP) -->
  <script is:inline>
    (function () {
      var imgs = document.querySelectorAll('img[data-lazysrc]');
      if (!imgs.length) return;
      function load(img) { img.src = img.getAttribute('data-lazysrc'); img.removeAttribute('data-lazysrc'); }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { load(e.target); io.unobserve(e.target); } });
        }, { rootMargin: '500px 0px' });
        for (var i = 0; i < imgs.length; i++) io.observe(imgs[i]);
      } else {
        for (var j = 0; j < imgs.length; j++) load(imgs[j]);
      }
    })();
  </script>
</Funnel>
