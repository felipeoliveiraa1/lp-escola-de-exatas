          <path d="M12 2.4 1.2 21.2a1 1 0 0 0 .87 1.5h19.86a1 1 0 0 0 .87-1.5z" fill="#FFBF00" stroke="#d99e00" stroke-width="0.6" stroke-linejoin="round"></path>
          <path d="M12 9v5.4" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round"></path>
          <circle cx="12" cy="18.2" r="1.25" fill="#1a1a1a"></circle>
