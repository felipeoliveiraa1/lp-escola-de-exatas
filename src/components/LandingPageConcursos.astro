        <h3><b>Atenção:</b> essa condição especial com desconto é por tempo limitado.</h3>
        <p class="atencao-card__sub">Não deixe para depois: cada dia perdido é um dia mais perto da prova sem dominar Exatas.</p>
        <div class="countdown" data-countdown data-minutes="25" role="timer" aria-label="Tempo restante da oferta">
          <div class="countdown__box"><span class="countdown__num" data-h>00</span><span class="countdown__lbl">Horas</span></div>
          <div class="countdown__box"><span class="countdown__num" data-m>25</span><span class="countdown__lbl">Minutos</span></div>
          <div class="countdown__box"><span class="countdown__num" data-s>00</span><span class="countdown__lbl">Segundos</span></div>
        </div>
        <a class="btn btn--pulse" href="#valor">QUERO DOMINAR EXATAS AGORA</a>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-countdown]');
        if (!el) return;
        var mins = parseInt(el.getAttribute('data-minutes') || '25', 10);
        var KEY = 'aee_countdown_end';
        var hEl = el.querySelector('[data-h]'), mEl = el.querySelector('[data-m]'), sEl = el.querySelector('[data-s]');
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function getEnd() {
          var end = 0;
          try { end = parseInt(localStorage.getItem(KEY) || '0', 10); } catch (e) {}
          if (!end || end < Date.now()) { end = Date.now() + mins * 60000; try { localStorage.setItem(KEY, String(end)); } catch (e) {} }
          return end;
        }
        var end = getEnd();
        function tick() {
          var rem = end - Date.now();
          if (rem <= 0) { end = getEnd(); rem = end - Date.now(); }
          var t = Math.floor(rem / 1000);
          hEl.textContent = pad(Math.floor(t / 3600));
          mEl.textContent = pad(Math.floor((t % 3600) / 60));
          sEl.textContent = pad(t % 60);
        }
        tick(); setInterval(tick, 1000);
      })();
    </script>
  </section>

